# Dependencies and build output
node_modules/
.next/
dist/
*.tsbuildinfo
frontend/next-env.d.ts

# Local environment. .env.example is the template Quick Start copies, so it stays.
.env
.env.*
!.env.example

# Runtime state, regenerated by the pipeline. This covers the store, its snapshots and backups,
# the engine cache, and baseline.db (ESCAP's completed answers, rebuilt by
# scripts/import-baseline and never redistributed).
backend/data/*.db
backend/data/*.db-*
backend/data/*.db.*
backend/data/cache/
backend/data/ocr/
backend/data/runs/
backend/data/fleet/
backend/data/exports/
backend/data/gpu/
backend/data/logs/
backend/data/*.log
backend/data/fx-rates.json

# Benchmark packs carry a reference with ESCAP's scores. Handed to teammates, never committed.
bench-pack/
lexdroid-bench*.zip

# Throwaway scripts
backend/scripts/zz-*.ts
backend/scripts/*.tmp.*

# docs/ is local except the architecture document and the operating notes. It holds ESCAP source material
# (docs/database and docs/framework, read by npm run setup), other teams' graded submissions and
# our drafts.
/docs/*
!/docs/architecture.md
!/docs/operating.md

# Editor, agent and OS files
.claude/
.playwright-mcp/
.vercel/
frontend/CLAUDE.md
frontend/AGENTS.md
.DS_Store
Thumbs.db
